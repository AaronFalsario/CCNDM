# ============================================================
# SECRETS — Actual credential files only
# ============================================================
# These match only files at project root or explicitly local,
# NOT source files under src/ or backend/
.env
.env.local
.env.production
.env.development
.env.*.local
backend/.env
backend/.env.local
*.local.env
secrets.local.js

# ============================================================
# DEPENDENCIES
# ============================================================
node_modules/
backend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
yarn.lock
pnpm-lock.yaml
# NOTE: package-lock.json is intentionally NOT ignored — Vercel needs it.

